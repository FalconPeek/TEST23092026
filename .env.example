# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only — bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=change-me
# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Local dev/e2e only (never in production). e2e specs create their own users with this password.
E2E_USER_PASSWORD=
# Optional: run e2e against an already running server / keep e2e data after the run
# E2E_BASE_URL=http://localhost:3000
# E2E_KEEP_DATA=1
# Password for the demo users created by npm run seed:demo (default picado-demo)
# DEMO_PASSWORD=
